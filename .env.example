# ===========================================
# FaceTune - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in values

# --- MongoDB ---
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/facetune?retryWrites=true&w=majority

# --- Auth.js (NextAuth v5) ---
AUTH_SECRET=  # Generate with: npx auth secret
NEXTAUTH_URL=http://localhost:3000

# --- Google OAuth ---
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- GitHub OAuth ---
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Audius API ---
AUDIUS_API_KEY=
AUDIUS_API_SECRET=

# --- YouTube Data API v3 ---
YOUTUBE_API_KEY=
